# Build environment. Recreate with:
#   python -m venv --system-site-packages .venv-export
#   .venv-export/bin/pip install "onnx==1.15.0" "onnxruntime==1.16.3"
.venv-export/
.venv-server/

__pycache__/
*.pyc

# Node is only used by the browser regression test.
node_modules/
tests/js/package-lock.json

# The ONNX Runtime WebAssembly binaries are pinned third-party build output:
# 10.6 MB each, and git stores them badly. Fetch them with
#   script/fetch_vendor.sh
web/assets/vendor/ort/*.wasm

# Local development symlink so `python -m http.server` inside web/ serves the
# data at /data/. Never committed: rsync --delete would carry the symlink to
# the server and replace the real data directory with it.
web/data

# Notebook checkpoints and the intermediate the atlas notebook writes; both
# are regenerated by re-running the notebook.
.ipynb_checkpoints/
data/atlas_source/

# Test and notebook caches
.pytest_cache/
